{
  "version": 2,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "routes": [
    { "src": "/$", "dest": "/api/index.php" },
    { "src": "/index.php$", "dest": "/api/index.php" },
    { "src": "/(favicon\\.ico|robots\\.txt)$", "dest": "/public/$1" },
    { "src": "/build/(.*)", "dest": "/public/build/$1" },
    { "src": "/storage/(.*)", "dest": "/public/storage/$1" },
    { "src": "/(.*\\.(?:css|js|png|jpg|jpeg|gif|svg|ico|ttf|woff|woff2|eot|otf|webp|avif|txt))$", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "buildCommand": "sh vercel-build.sh",
  "outputDirectory": "public"
}
